<?xml version="1.0" encoding="UTF-8"?>
<!--
  SnoopingOwl Setup bootstrapper (WiX v5 Burn).

  Professional installation experience:
    Welcome -> License -> Install -> Progress -> Completion
  The MSI is the actual product package; this bundle wraps it with the
  RTF license page. Install location is fixed (%ProgramFiles%\SnoopingOwl)
  as is standard for managed enterprise agents; the Options UI is
  suppressed for that reason.

  Build (Windows, from this directory after building SnoopingOwl.msi):
    wix build bundle.wxs -o SnoopingOwlSetup.exe
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:bal="http://wixtoolset.org/schemas/v4/wxs/bal">

  <Bundle Name="SnoopingOwl"
          Manufacturer="SnoopingOwl"
          Version="0.1.0"
          UpgradeCode="B51F604C-1480-4661-A9F1-F83474EF026B"
          Copyright="Copyright (c) SnoopingOwl. All rights reserved.">

    <BootstrapperApplication>
      <bal:WixStandardBootstrapperApplication
          Theme="rtfLicense"
          LicenseFile="license.rtf"
          SuppressOptionsUI="yes" />
    </BootstrapperApplication>

    <Chain>
      <MsiPackage SourceFile="SnoopingOwl.msi" Vital="yes" />
    </Chain>
  </Bundle>
</Wix>